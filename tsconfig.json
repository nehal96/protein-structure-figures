{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@hooks": ["./src/site/hooks.ts"],
      "@ui/controls": ["./src/site/controls/index.ts"],
      "@lib/utils": ["./src/site/utils.ts"],
      "next/dynamic": ["./src/site/next-dynamic.tsx"]
    }
  },
  "include": ["src"]
}
